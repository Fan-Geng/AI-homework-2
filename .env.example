# Standalone profile for a compatible gateway
# Copy to .env and replace placeholder values before starting the router.
# The website is fixed, but model families can still use separate logical API keys.
# Default assumption here: all logical providers share the same website base URL.

ROUTER_RUNTIME_MODE=standalone
ROUTER_ENABLE_STANDALONE_KEYS=true
ROUTER_ENABLE_ADMIN_API=true
ROUTER_ENABLE_USAGE_API=true

ADMIN_API_KEY=admin-change-me
ROUTER_API_KEY=router-change-me
ROUTER_DB=router.db

AUTO_SYNC_PROVIDER_MODELS=true
AUTO_SYNC_PROVIDER_MODELS_TIMEOUT=20

GATEWAY_BASE_URL=https://your-gateway.example/v1

# Optional per-family base URL overrides. If you leave them unset,
# app/core/config.py will automatically fall back to GATEWAY_BASE_URL.
# OPENAI_BASE_URL=https://your-gateway.example/v1
# ANTHROPIC_BASE_URL=https://your-gateway.example/v1
# DEEPSEEK_BASE_URL=https://your-gateway.example/v1
# GLM_BASE_URL=https://your-gateway.example/v1

OPENAI_KEY_1=replace-with-your-openai-family-key
ANTHROPIC_KEY_1=replace-with-your-claude-family-key
DEEPSEEK_KEY_1=replace-with-your-deepseek-family-key
GLM_KEY_1=replace-with-your-glm-family-key

# Optional
# OPENAI_KEY_2=replace-with-your-second-openai-family-key
# ANTHROPIC_KEY_2=replace-with-your-second-claude-family-key
# DEEPSEEK_KEY_2=replace-with-your-second-deepseek-family-key
# GLM_KEY_2=replace-with-your-second-glm-family-key
# GATEWAY_KEY_1=legacy-compatibility-only
# OTHERS_KEY_1=legacy-compatibility-alias-for-GLM_KEY_1


# ============================================================
# 以下为 RSL 作业需要追加的配置
# 上面是课程 ModelRouter 原有的网关部署配置，默认保持不变；
# 只想跑 RSL 作业时，用下面这组配置覆盖同名变量即可。
# ============================================================

# ---- 运行模式：作业只在本机跑，用 internal 关闭对外的管理接口 ----
ROUTER_RUNTIME_MODE=internal
ROUTER_ENABLE_STANDALONE_KEYS=false
ROUTER_ENABLE_ADMIN_API=false
ROUTER_ENABLE_USAGE_API=false

# 本地访问口令，homework.py 调用 /v1/rsl/run 时必须带上。
# 必须替换成自己的随机字符串，不要提交真实值。
ROUTER_INTERNAL_API_KEY=replace-with-your-local-access-token

# 作业不需要启动时自动同步上游模型，减少额外网络请求
AUTO_SYNC_PROVIDER_MODELS=false

# 数据库与经验目录都放在 results/ 下，便于整体清理和重做实验
ROUTER_DB=results/router.db
RSL_OUTPUT=results/private

# ---- 模型服务 ----
# 可接本机 Ollama、SSH 转发后的云端 Ollama，或任何兼容 OpenAI 接口的服务。
# 本机 Ollama 默认地址：http://127.0.0.1:11434/v1
OPENAI_BASE_URL=http://127.0.0.1:11434/v1

# 本机 Ollama 填任意非空字符串即可；云端兼容 API 填自己的真实密钥。
OPENAI_KEY_1=ollama

# 实际参与 RSL 的模型名，需与本地已拉取的模型完全一致。
HOMEWORK_MODEL=qwen2.5:14b-instruct